{
  "name": "sing-sub",
  "private": true,
  "version": "3.1.6",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real-backend": "node scripts/run-real-backend-preview.mjs",
    "preview:real-backend": "npm run build && node scripts/run-real-backend-preview.mjs --production",
    "lint": "eslint .",
    "check:licenses": "node scripts/check-ui-licenses.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "typecheck:shared": "tsc -p tsconfig.shared.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck": "npm run typecheck:shared && npm run typecheck:web && npm run typecheck:worker",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "build": "npm run typecheck && vite build",
    "worker:dry-run": "npm run build && wrangler deploy --dry-run",
    "verify": "npm run lint && npm run check:licenses && npm run typecheck && npm run test && vite build && npm run check:bundle && npm run test:e2e -- --production",
    "preview": "wrangler dev",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy": "npm run build && npm run deploy:cloudflare"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.5.0",
    "@mantine/form": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/modals": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "19.2",
    "react-dom": "19.2",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260711.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "wrangler": "^4"
  }
}
